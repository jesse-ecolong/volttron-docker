        },
        "HTGTEMPSETPOINT living_unit1": {
            "name": "heating_sch",
            "type": "schedule",
            "topic": "PNNL/RESIDENTIAL/living_unit1",
            "field": "ZoneHeatingTemperatureSetPoint",
            "default": 18.22,
            "dynamic_default": 1.0
        }
    },
